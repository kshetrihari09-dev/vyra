# Frontend (Vite). Copy to .env.local for local development.
#
# Base URL of the API. Leave as /api so the browser talks to the same origin:
#   - dev:  Vite proxies /api -> http://localhost:4000 (see vite.config.js)
#   - prod (Nginx):  Nginx proxies /api -> the Node process
#   - prod (Vercel): frontend/vercel.json rewrites /api/* -> the deployed backend. Leave this unset on Vercel.
#     Do NOT set it to the backend's own URL: that makes the refresh cookie cross-site and breaks session refresh.
# The refresh cookie is SameSite=Strict, so the API must be served from the same site as the web app.
VITE_API_URL=/api

# Where the dev proxy forwards /api (dev only).
VITE_DEV_API_TARGET=http://localhost:4000

# Public Mapbox token (starts with "pk.") for the live delivery map. It ships to the browser, so restrict it by URL in the
# Mapbox dashboard. Without it the map is replaced by an explanatory note; status, ETA and rider details keep working.
VITE_MAPBOX_TOKEN=
