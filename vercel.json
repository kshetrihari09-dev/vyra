{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/check-vercel-config.mjs && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-VYRA-BACKEND-ORIGIN/api/:path*" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
